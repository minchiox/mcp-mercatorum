{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!dist", "!coverage", "!**/fixtures"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "performance": { "useDomNodeTextContent": "off" },
      "suspicious": { "noConsole": { "level": "error", "options": { "allow": ["error"] } } }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
